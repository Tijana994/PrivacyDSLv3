<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared data comes from data source 'Internal', which is defined in the configuration. -->
<privacyModel:PrivacyPolicy xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:privacyModel="http://privacymodel"
    name="Test policy" owner="//@allPrincipals.0">
  <allPrincipals name="Company" inhabits="//@locations.0"/>
  <locations name="Serbia" type="Country" legalAgeLimit="18"/>
  <configurationManager>
    <dataSources>Internal</dataSources>
    <protectionControlMethods>Encryption</protectionControlMethods>
  </configurationManager>
  <privacyPolicyHelper/>
  <allDatas name="email"/>
  <allSharedPrivacyData name="Ana email" privacydata="//@allDatas.0" dataSource="Internal"/>
</privacyModel:PrivacyPolicy>
